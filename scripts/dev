#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUNTIME="$ROOT/.runtime"
if [[ "${1:-}" != "" && "${1:-}" != "--bridges" ]]; then
  printf 'Usage: ./scripts/dev [--bridges]\n' >&2
  exit 2
fi
mkdir -p "$RUNTIME"

PIDS=()
REQUIRED_PIDS=()
GEMINI_STARTED=0

log() { printf '[cutline] %s\n' "$*"; }
port_open() { lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }
wait_url() {
  local name="$1" url="$2" attempts="${3:-60}"
  for ((i=1; i<=attempts; i++)); do
    if curl --silent --fail --max-time 2 "$url" >/dev/null 2>&1; then
      log "$name ready: $url"
      return 0
    fi
    sleep 1
  done
  log "$name did not become ready: $url"
  return 1
}
  start_process() {
  local name="$1" directory="$2" logfile="$3"
  shift 3
  (cd "$directory" && exec "$@") >"$RUNTIME/$logfile" 2>&1 &
  local pid=$!
  PIDS+=("$pid")
  [[ "$name" == "ChatGPT Web bridge" || "$name" == "FlowKit bridge" ]] || REQUIRED_PIDS+=("$pid")
  log "starting $name (log: .runtime/$logfile)"
}
cleanup() {
  trap - EXIT INT TERM
  log "stopping local services"
  for pid in "${PIDS[@]:-}"; do
    kill "$pid" >/dev/null 2>&1 || true
  done
  for pid in "${PIDS[@]:-}"; do
    wait "$pid" >/dev/null 2>&1 || true
  done
  if [[ "$GEMINI_STARTED" == 1 ]]; then
    docker compose -f "$ROOT/bridges/docker-compose.yml" stop gemini-web >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT INT TERM

command -v uv >/dev/null || { log "uv is required"; exit 1; }
command -v npm >/dev/null || { log "npm is required"; exit 1; }
command -v curl >/dev/null || { log "curl is required"; exit 1; }
command -v lsof >/dev/null || { log "lsof is required"; exit 1; }

if [[ ! -x "$ROOT/backend/.venv/bin/movie-worker" ]]; then
  (cd "$ROOT/backend" && uv sync --locked)
fi
if [[ ! -d "$ROOT/frontend/node_modules" ]]; then
  (cd "$ROOT/frontend" && npm ci)
fi

if [[ "${1:-}" == "--bridges" ]]; then

  if command -v docker >/dev/null && docker info >/dev/null 2>&1; then
    if ! port_open 4981 && [[ -f "$ROOT/bridges/gemini-web-to-api/Dockerfile" && -f "$ROOT/bridges/.env" ]]; then
      log "starting Gemini Web bridge"
      if docker compose -f "$ROOT/bridges/docker-compose.yml" up -d gemini-web; then
        GEMINI_STARTED=1
      else
        log "Gemini bridge failed to start; continuing without it"
      fi
    fi
    if port_open 4981; then
      wait_url "Gemini Web" "http://127.0.0.1:4981/health" 10 || log "Gemini fallback unavailable"
    else
      log "Gemini bridge not configured or unavailable; continuing without it"
    fi
  else
    log "Docker is not running; Gemini fallback will be unavailable"
  fi

  set -a
  if [[ -f "$ROOT/bridges/chatgpt.env" ]]; then
    # shellcheck disable=SC1091
    source "$ROOT/bridges/chatgpt.env"
  else
    log "bridges/chatgpt.env is missing; ChatGPT Web bridge will be skipped"
  fi
  set +a

  if [[ -f "$ROOT/bridges/chatgpt.env" ]] && ! port_open 8791; then
    if [[ -x "$ROOT/bridges/chatgpt-web-provider/.venv/bin/chatgpt-web-provider" ]]; then
      start_process "ChatGPT Web bridge" "$ROOT/bridges/chatgpt-web-provider" "chatgpt.log" \
        env PLAYWRIGHT_BROWSERS_PATH="$ROOT/bridges/.playwright" .venv/bin/chatgpt-web-provider
    else
      log "ChatGPT Web bridge is not installed; continuing with mock/Ollama"
    fi
  fi
  bridge_key="${CHATGPT_WEB_API_KEYS:-}"
  if port_open 8791; then
    if wait_url "ChatGPT Web" "http://127.0.0.1:8791/health" 10 && ! curl --silent --fail --max-time 4 -H "Authorization: Bearer ${bridge_key%%,*}" \
      "http://127.0.0.1:8791/v1/provider/capabilities" | grep -q 'status_endpoint'; then
      log "Port 8791 lacks image monitoring or authentication failed; browser images may be unavailable."
    fi
  else
    log "ChatGPT Web is offline; prototype parser remains available"
  fi

  FLOWKIT_DIR="${MOVIE_FLOWKIT_ROOT:-$ROOT/../flowkit}"
  if ! port_open 8100 && [[ -x "$FLOWKIT_DIR/venv/bin/python" ]]; then
    start_process "FlowKit bridge" "$FLOWKIT_DIR" "flowkit.log" \
      "$FLOWKIT_DIR/venv/bin/python" -u -m agent.main
  fi
  if port_open 8100 || [[ -x "$FLOWKIT_DIR/venv/bin/python" ]]; then
    wait_url "FlowKit" "http://127.0.0.1:8100/api/flow/status" 10 || log "FlowKit video bridge unavailable"
  fi
else
  log "Optional browser bridges skipped; use --bridges after configuring them"
fi

if ! port_open 8000; then
  start_process "FastAPI" "$ROOT/backend" "api.log" \
    env UV_CACHE_DIR=/tmp/movie-creator-uv-cache uv run movie-api
fi
wait_url "FastAPI" "http://127.0.0.1:8000/api/health" 30

# Always (re)start workers so newly added Huey tasks are registered.
if pgrep -f "huey_consumer.*backend.tasks.image_huey" >/dev/null 2>&1 || pgrep -f "movie-worker" >/dev/null 2>&1; then
  log "restarting persistent workers so task registry stays current"
  pkill -f "huey.bin.huey_consumer backend.tasks" >/dev/null 2>&1 || true
  pkill -f "backend/.venv/bin/movie-worker" >/dev/null 2>&1 || true
  pkill -f "backend/.venv/bin/python.*movie-worker" >/dev/null 2>&1 || true
  sleep 1
fi
[[ -x "$ROOT/backend/.venv/bin/movie-worker" ]] || { log "backend worker is not installed; run 'cd backend && uv sync'"; exit 1; }
start_process "persistent workers" "$ROOT/backend" "worker.log" \
  .venv/bin/movie-worker

if ! port_open 5173; then
  start_process "Vue frontend" "$ROOT/frontend" "frontend.log" \
    npm run dev -- --host 127.0.0.1
fi
wait_url "Cutline" "http://127.0.0.1:5173/" 30

log "all available services are ready"
log "open http://127.0.0.1:5173/"
log "press Ctrl+C to stop services started by this command"

while true; do
  # When every dependency was already listening, PIDS stays empty. Do not treat
  # an empty expansion as a dead child (bash "${PIDS[@]:-}" → one empty word).
  if ((${#REQUIRED_PIDS[@]} > 0)); then
    for pid in "${REQUIRED_PIDS[@]}"; do
      [[ -n "$pid" ]] || continue
      if ! kill -0 "$pid" >/dev/null 2>&1; then
        log "a managed service stopped; inspect .runtime logs"
        exit 1
      fi
    done
  fi
  sleep 2
done

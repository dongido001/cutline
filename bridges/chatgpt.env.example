# The setup command replaces these paths with paths on your machine.
CHATGPT_WEB_API_KEYS=replace-with-a-long-random-token
CHATGPT_WEB_BACKEND=browser
CHATGPT_WEB_MODEL=chatgpt-5.6-sol-high-web
CHATGPT_WEB_HOST=127.0.0.1
CHATGPT_WEB_PORT=8791
CHATGPT_WEB_PUBLIC_BASE_URL=http://127.0.0.1:8791
CHATGPT_WEB_PROFILE_DIR=/absolute/path/to/bridges/chatgpt-profile
CHATGPT_WEB_HEADLESS=false
CHATGPT_WEB_REQUEST_TIMEOUT_SECONDS=300
# Parallel image tabs in one Chromium profile. Match MOVIE_IMAGE_WORKER_CONCURRENCY.
CHATGPT_WEB_MAX_CONCURRENT_REQUESTS=1
CHATGPT_WEB_QUEUE_TIMEOUT_SECONDS=600

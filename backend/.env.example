MOVIE_TEXT_PROVIDER=mock
MOVIE_OLLAMA_BASE_URL=http://127.0.0.1:11434
MOVIE_OLLAMA_MODEL=qwen3:8b
MOVIE_COMPATIBLE_BASE_URL=http://127.0.0.1:6969/v1
MOVIE_COMPATIBLE_MODEL=gemini-3-pro-plus
MOVIE_COMPATIBLE_API_KEY=
MOVIE_GEMINI_WEB_BASE_URL=http://127.0.0.1:4981/openai/v1
MOVIE_GEMINI_WEB_MODEL=gemini-advanced
MOVIE_IMAGE_PROVIDERS=chatgpt_web,gemini_web
MOVIE_VIDEO_PROVIDER=flowkit
# Video jobs in flight; FlowKit independently throttles submissions.
MOVIE_VIDEO_WORKER_CONCURRENCY=1
MOVIE_FLOWKIT_BASE_URL=http://127.0.0.1:8100/api/flow
MOVIE_FLOWKIT_PROJECT_ID=
MOVIE_FLOWKIT_TIMEOUT_SECONDS=900
MOVIE_FLOWKIT_MODEL_FAMILY=omni_flash
MOVIE_RUNWAY_API_KEY=
MOVIE_RUNWAY_MODEL=gen4_turbo
MOVIE_RUNWAY_MAX_DURATION=5
MOVIE_RUNWAY_RATIO_LANDSCAPE=1280:720
MOVIE_RUNWAY_RATIO_PORTRAIT=720:1280
MOVIE_RUNWAY_TIMEOUT_SECONDS=900
MOVIE_COMFYUI_BASE_URL=http://127.0.0.1:8188
MOVIE_COMFYUI_WORKFLOW_PATH=./data/comfyui_i2v_workflow.json
MOVIE_COMFYUI_TIMEOUT_SECONDS=1800
MOVIE_VIDEO_FPS=16
MOVIE_VIBEVOICE_ROOT=
MOVIE_VIBEVOICE_MODEL=microsoft/VibeVoice-1.5B
MOVIE_VIBEVOICE_PYTHON=python
MOVIE_VIBEVOICE_MODE=subprocess
MOVIE_VIBEVOICE_TIMEOUT_SECONDS=600
MOVIE_EXPORT_WIDTH_LANDSCAPE=1920
MOVIE_EXPORT_HEIGHT_LANDSCAPE=1080
MOVIE_EXPORT_WIDTH_SHORTS=1080
MOVIE_EXPORT_HEIGHT_SHORTS=1920
MOVIE_GEMINI_WEB_IMAGE_MODEL=gemini-3-pro-image-preview-11-2025
MOVIE_CHATGPT_WEB_BASE_URL=http://127.0.0.1:8791/v1
MOVIE_CHATGPT_WEB_MODEL=chatgpt-5.6-sol-high-web
MOVIE_CHATGPT_WEB_API_KEY=

# Publishing
# mock keeps publish jobs local and records dry-run URLs. Set to live only after OAuth/token setup.
MOVIE_PUBLISH_MODE=mock
MOVIE_YOUTUBE_ACCESS_TOKEN=
MOVIE_YOUTUBE_CHANNEL_ID=
MOVIE_FACEBOOK_PAGE_ACCESS_TOKEN=
MOVIE_FACEBOOK_PAGE_ID=
MOVIE_GOOGLE_CLIENT_ID=
MOVIE_GOOGLE_CLIENT_SECRET=
MOVIE_FACEBOOK_APP_ID=
MOVIE_FACEBOOK_APP_SECRET=
